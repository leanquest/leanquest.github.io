{
  "name": "leanquest",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run licenses:generate",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --experimental-strip-types --experimental-specifier-resolution=node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "images:license": "node scripts/embed-cc0-image-license.mjs",
    "music:generate": "node scripts/generate-music.mjs && node scripts/embed-story-music-license.mjs",
    "music:license": "node scripts/embed-combat-music-license.mjs && node scripts/embed-story-music-license.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
